// MemberHub - generic multi-tenant core.
//
// Conventions:
// - Every business table carries orgId and an @@index([orgId, ...]). Isolation is enforced
//   twice: in application code (always query through the org-scoped helper) and in Postgres
//   via row level security (see prisma/rls-template.sql).
// - Money is stored as integer minor units (agorot / cents) plus an ISO currency code.
//   Never Float. (d3teman's Transaction.amount was a Float - fixed here on purpose.)
// - Org-type specifics (terminology, extra fields, request kinds) live in packs
//   (src/packs/*), not in columns. Free-form per-org data goes into the customFields JSON.
// - Pack-owned structured tables are allowed only in the PACK TABLES section at the bottom.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy and access
// ---------------------------------------------------------------------------

// One customer of the platform: a building committee, a synagogue, a gym, a club.
model Organization {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  packId         String // hoa | synagogue | gym | club | generic  (see src/packs)
  country        String   @default("IL") // ISO 3166-1 alpha-2
  currency       String   @default("ILS") // ISO 4217 default for new plans and charges
  locale         String   @default("he") // UI language
  timezone       String   @default("Asia/Jerusalem")
  settings       Json     @default("{}") // pack-specific org settings, letterhead, branding, etc.
  status         String   @default("active") // setup (wizard not finished) | active | suspended | closed
  // Wallet identity: what members see on their membership badge.
  logoUrl        String?
  brandColor     String? // hex; suggested from the logo, overridable by the org (members can override per card)
  // "private": never shown in search, people join by invitation only (gym, synagogue with front-desk signup).
  // "listed": appears in search; people can send a join request, an admin must approve it.
  visibility     String   @default("private") // private | listed
  city           String? // shown in search results next to the name; search matches name or city
  // The org's shareable join link (/join/<token>). Whoever opens it sends a join request; an admin approves.
  joinToken      String?  @unique
  // Platform business model: what this org pays us.
  platformPlan   String   @default("free") // free | monthly | yearly (placeholder names)
  platformFeeBps Int      @default(0) // optional percentage of payments, in basis points
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orgUsers         OrgUser[]
  members          Member[]
  labels           MembershipLabel[]
  memberLabels     MemberLabel[]
  households       Household[]
  householdMembers HouseholdMember[]
  funds            Fund[]
  plans            Plan[]
  subscriptions    Subscription[]
  charges          Charge[]
  payments         Payment[]
  allocations      PaymentAllocation[]
  invoices         Invoice[]
  expenses         Expense[]
  events           Event[]
  requests         Request[]
  joinRequests     JoinRequest[]
  notifications    Notification[]
  invitations      Invitation[]
  dataPolicies     OrgDataPolicy[]
  disputes         ChargeDispute[]
  debtReminders    DebtReminder[]
  campaigns        Campaign[]
  paymentAccounts  PaymentAccount[]
  auditLogs        AuditLog[]
  yahrzeits        Yahrzeit[]
  pledges          Pledge[]
  prayers          Prayer[]
  prayerChanges    PrayerChange[]
  parkingSpots     ParkingSpot[]
  rsvps            Rsvp[]
  posts            ChannelPost[]
  importBatches    ImportBatch[]
  chargeDrafts     ChargeDraft[]
}

// A person with an account in the app. Global, not per org: one person holds memberships in many orgs
// (the "wallet") and may administer several. Contact details live in UserContact, not here.
// A child or other family member without a phone or email simply has no User; they exist only
// as a Member inside the household and need no account.
model User {
  id                 String   @id @default(cuid())
  // Both required at sign-up (decided 13.10.2026). Other members usually see the first name only;
  // the UI adds a distinguishing detail only when two people in the same org share it.
  firstName          String?
  lastName           String?
  displayName        String?
  gender             String? // male | female | undisclosed. Drives Hebrew address (חבר/חברה); null or undisclosed → masculine. Shared with an org only when the org requests it as a field and the member consents.
  language           String? // preferred message language (he, en, ...); visible to orgs the member joined, so they can write in the right language
  preferences        Json? // { timeAxis: ltr|rtl (default ltr), quietHours, notifyChannels }; display preferences, not accessibility
  accessibility      Json? // { textSize: normal|large|xlarge, highContrast, reduceMotion, strongFocus }; applies in every membership, device settings are the default
  locale             String   @default("he") // UI language; the member's choice, independent of the org's
  passwordHash       String?
  mustChangePassword Boolean  @default(false)
  // The permanent profile code (board D-QrMyCode, ux-spec 14.29): /p/<code>. An org manager scans it to
  // send a join invitation; it shows only the first name until the person accepts. Replaceable.
  profileCode        String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  contacts       UserContact[]
  authSessions   AuthSession[]
  orgUsers       OrgUser[]
  joinRequests   JoinRequest[]
  notifications  Notification[]
  disputesOpened ChargeDispute[]
}

// A VERIFIED email address or phone number of a user. Only verified values are stored here, so the
// unique index cannot be used to probe whether a number is registered or to squat on someone else's.
// A user may hold several (new number, work email); invitations to any of them reach the same account.
// Two accounts are merged only when the person verifies both contacts; never by name similarity.
model UserContact {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // email | phone
  value      String // normalized: lower-case email, E.164 phone (src/lib/phone.ts)
  isPrimary  Boolean  @default(false)
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([kind, value])
  @@index([userId])
}

// A one-time code sent to an email or phone, consumed to turn it into a UserContact.
// Not unique on value: many people may be asked to verify the same value; only the one who enters
// the code and passes the unique UserContact check keeps it.
model ContactChallenge {
  id         String    @id @default(cuid())
  userId     String? // null while registering
  kind       String // email | phone
  value      String
  codeHash   String
  attempts   Int       @default(0) // lock after a few wrong tries
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([kind, value])
  @@index([expiresAt])
}

// One signed-in device or browser ("connected devices" in settings). The session cookie carries this id,
// so a session can be revoked from another device. Approximate location is the city the hosting edge
// derived from the IP address, shown to the owner only with "(בערך)". We never ask for device location.
model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sliding: phone and "remember" on desktop renew on use and end after 180 idle days.
  // fixed: desktop with "remember" switched off ends when the browser closes (cookie) or after 12 hours.
  kind       String    @default("sliding") // sliding | fixed
  deviceKind String    @default("computer") // phone | tablet | computer
  label      String // "iPhone · Safari", derived from the user agent
  city       String? // approximate, from the edge's IP geolocation header; null when unknown
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
}

// Rate limit and growing lockout for sign-in, keyed by contact value or IP ("phone:+9725...", "ip:1.2.3.4").
// The same rules apply whether or not the contact belongs to an account, so the lock never reveals that.
model AuthThrottle {
  key         String    @id
  sends       Int       @default(0) // codes sent in the current window
  failures    Int       @default(0) // wrong codes in the current window
  windowStart DateTime  @default(now())
  strikes     Int       @default(0) // how many locks so far; each lock lasts longer (1, 5, 30 minutes)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// Security log for sign-in events (code sent, login, failed code, lock, new device, phone change).
// Not org-scoped: it belongs to the platform. Kept per docs/retention-policy.he.md.
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  kind      String // code_sent | login | signup | code_failed | locked | session_revoked | phone_change_requested | phone_change_approved
  contact   String? // normalized value the event was about
  ip        String?
  city      String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([contact, createdAt])
}

// "I have no access to my phone": the person proves the NEW number with a code, names an org they belong
// to, and an admin of that org confirms it is them. The change takes effect 3 days after approval unless
// the person objects from any existing contact; the old number is told about it (decided 13.10.2026).
model PhoneChangeRequest {
  id          String    @id @default(cuid())
  userId      String
  orgId       String
  oldValue    String // E.164
  newValue    String // E.164, verified by code when the request was made
  status      String    @default("pending") // pending | approved | rejected | cancelled | done
  decidedById String?
  decidedAt   DateTime?
  effectiveAt DateTime? // decidedAt + 3 days
  createdAt   DateTime  @default(now())

  @@index([orgId, status])
  @@index([userId])
}

// One person's membership in one org, and everything they decided about it. This is the "badge".
// Not to be confused with Member (the org's own record of a person, which can exist with no login).
model OrgUser {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String       @default("member") // owner | admin | treasurer | staff | member | guest (celebrations)
  // active | suspended | left | left_with_debt. A user may always request to leave; with an open
  // balance the badge stays in the wallet as "left_with_debt" and the org keeps only the fields it
  // marked mandatory, for collection. We do not block leaving and we do not adjudicate disputes.
  status   String       @default("active")
  leftAt   DateTime?
  memberId String?      @unique // the Member record this login represents inside the org
  member   Member?      @relation(fields: [memberId], references: [id])

  // Consent. Fields the member hides from the org (the org's mandatory fields can never be hidden).
  hiddenFields          String[] @default([])
  acceptedPolicyVersion Int? // OrgDataPolicy.version the member agreed to

  // Wallet personalization, per user, invisible to the org.
  cardColor   String? // overrides Organization.brandColor; picked from a curated palette
  walletGroup String? // the member's own grouping ("home", "health", "community")
  walletOrder Int       @default(0)
  isPinned    Boolean   @default(false)
  hiddenAt    DateTime? // the member moved the card to the wallet archive (board D-WalletArchive)
  deletedAt   DateTime? // the member deleted the card from the archive (board D-WalletDelete); gone from their wallet

  createdAt DateTime @default(now())

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

// Which member fields an org requires. Changes take effect only after a notice period (30 days by
// default) so members can react or leave. The platform keeps a ceiling in code (src/lib/privacy):
// name and a contact method are always mandatory; anything else mandatory needs a stated reason.
model OrgDataPolicy {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  version         Int
  mandatoryFields String[]     @default([]) // e.g. ["name", "phone", "address"]
  optionalFields  String[]     @default([]) // asked for, member decides
  reasons         Json         @default("{}") // { "address": "needed to send the building bill" }
  announcedAt     DateTime     @default(now())
  effectiveFrom   DateTime // announcedAt + notice period; the active policy is the latest already effective

  @@unique([orgId, version])
  @@index([orgId, effectiveFrom])
}

// The org (an admin) invites a person by phone or email. The person need not have an account yet:
// the invitation waits and attaches only when someone verifies that exact contact (UserContact).
// Joining always needs both sides: the admin invites, the person accepts.
model Invitation {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind             String // email | phone
  value            String // normalized
  memberId         String? // the Member record the admin prepared; the user attaches to it on acceptance
  role             String       @default("member")
  invitedById      String // User.id of the admin
  status           String       @default("pending") // pending | accepted | declined | expired | revoked
  expiresAt        DateTime // default 30 days; phone numbers get recycled
  linkToken        String?      @unique // random token in the invitation link (/login?invite=...); also typed as an invite code
  respondedAt      DateTime?
  acceptedByUserId String?
  // Chosen by the admin when inviting (boards D-MAdmInvite, D-AdmImport3); applied when the person accepts.
  name             String? // how the admin wrote the name; "שלום" alone when empty
  planId           String?
  labelIds         String[]     @default([])
  channel          String? // whatsapp | sms | email | link: how the admin chose to send it
  batchId          String? // the file import it came from
  batch            ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())

  // Application rule: at most one pending invitation per org + kind + value.
  @@index([kind, value, status])
  @@index([orgId, status])
}

// ---------------------------------------------------------------------------
// People and households
// ---------------------------------------------------------------------------

// A person inside an org: tenant, community member, gym member, club member.
model Member {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  email        String? // nullable: family members may have no login
  phone        String?
  phone2       String?
  street       String?
  city         String?
  status       String       @default("active") // pending | active | inactive
  // Pack-defined extra fields (halachic status, children counts, etc.), validated against the pack.
  customFields Json         @default("{}")
  // Directory privacy, generalized from d3teman's showPhone/showAddress/receiveNewsletter.
  privacy      Json         @default("{}")
  notes        String?
  // The member number on the card (board D-Badge), given in order of joining, once, never reused.
  number       Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orgUser        OrgUser?
  householdLinks HouseholdMember[]
  subscriptions  Subscription[]
  charges        Charge[]
  payments       Payment[]
  events         Event[]
  requests       Request[]
  yahrzeits      Yahrzeit[]
  pledges        Pledge[]
  debtReminders  DebtReminder[]
  labels         MemberLabel[]

  @@unique([orgId, number])
  @@index([orgId, lastName, firstName])
  @@index([orgId, phone])
  @@index([orgId, email])
}

// The billable unit: an apartment (HOA), a family (synagogue), a membership account (gym/club).
model Household {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  label        String // "14" for a flat, a family name, an account name
  customFields Json         @default("{}")
  createdAt    DateTime     @default(now())

  members       HouseholdMember[]
  subscriptions Subscription[]
  charges       Charge[]
  payments      Payment[]
  parkingSpots  ParkingSpot[]

  @@unique([orgId, label])
  @@index([orgId])
}

// Who belongs to a household and for which period. Dated on purpose: the HOA project's
// whole billing logic depends on who lived in a flat in which month (tenant turnover).
model HouseholdMember {
  id                  String       @id @default(cuid())
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  householdId         String
  household           Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  memberId            String
  member              Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  relation            String       @default("member") // owner | tenant | head | spouse | child | member
  isHead              Boolean      @default(false)
  // Up to two people (e.g. both spouses) may act as payers for the household: see and pay its charges.
  // Application rule: at most two payers per household at a time.
  isPayer             Boolean      @default(false)
  isBilled            Boolean      @default(true) // false for a person who lives there but is not billed
  startsOn            DateTime?    @db.Date // null = since forever
  endsOn              DateTime?    @db.Date // null = still current
  // Opening balance carried in from before the system, in minor units (HOA: חוב_התחלתי_היסטורי).
  openingBalanceMinor Int          @default(0)
  createdAt           DateTime     @default(now())

  @@index([orgId, householdId, startsOn])
  @@index([orgId, memberId])
}

// ---------------------------------------------------------------------------
// Money: funds, plans, subscriptions, charges, payments
// ---------------------------------------------------------------------------

// A ledger bucket. HOA: general fund, camera fund, parking gate. Synagogue: donation targets.
model Fund {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key         String // stable machine key, e.g. "general"
  displayName String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  plans    Plan[]
  charges  Charge[]
  payments Payment[]
  expenses Expense[]

  @@unique([orgId, key])
  @@index([orgId])
}

// A price and rule set. "rules" carries the fee schedule (see src/lib/billing/schedule.ts).
model Plan {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fundId      String?
  fund        Fund?        @relation(fields: [fundId], references: [id])
  name        String
  interval    String       @default("month") // month | year | once | per_visit
  amountMinor Int          @default(0) // default fee; dated changes live in rules.changes
  currency    String       @default("ILS")
  // { changes: {"2025-10": 27500}, routineSpecials: {...}, oneTimeCharges: {...}, perUnit: false }
  rules       Json         @default("{}")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  subscriptions Subscription[]
  labels        MembershipLabel[]

  @@index([orgId])
}

// A household (or a single member) attached to a plan for a period.
model Subscription {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan         @relation(fields: [planId], references: [id])
  householdId String?
  household   Household?   @relation(fields: [householdId], references: [id])
  memberId    String?
  member      Member?      @relation(fields: [memberId], references: [id])
  // Multiplier, e.g. number of children for the HOA daycare per-child fee.
  quantity    Int          @default(1)
  status      String       @default("active") // active | frozen | cancelled | ended
  startsOn    DateTime     @db.Date
  endsOn      DateTime?    @db.Date
  frozenFrom  DateTime?    @db.Date // gym freeze
  frozenUntil DateTime?    @db.Date
  createdAt   DateTime     @default(now())

  charges Charge[]

  @@index([orgId, householdId])
  @@index([orgId, status])
}

// Something owed. Generated by the billing engine or entered by hand.
model Charge {
  id             String        @id @default(cuid())
  orgId          String
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fundId         String?
  fund           Fund?         @relation(fields: [fundId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  householdId    String?
  household      Household?    @relation(fields: [householdId], references: [id])
  memberId       String? // who is billed (the tenant at that time)
  member         Member?       @relation(fields: [memberId], references: [id])
  periodMonth    DateTime?     @db.Date // first day of the billed month, null for non-periodic
  kind           String        @default("recurring") // recurring | special | one_time | adjustment
  description    String
  note           String? // the org's explanation to members, shown on the charge (board D-AdmCharge)
  amountMinor    Int
  currency       String        @default("ILS")
  fraction       Decimal?      @db.Decimal(6, 5) // share of the month when pro-rated (1/3 -> 0.33333)
  dueOn          DateTime?     @db.Date // "לתשלום עד"; null = two weeks after it was created
  voidedAt       DateTime?
  // Set by the billing engine to make generation idempotent, e.g. "<subscriptionId>|<memberId>|2026-10|recurring".
  // Null for hand-entered charges (Postgres allows many NULLs in a unique index).
  dedupeKey      String?
  // Choices from "חיוב חדש" (board D-AdmCharge): the member may pay part of it, and automatic reminders
  // 3 days before and on the day (sent once the scheduler exists, docs/waiting-for-services.he.md).
  allowPartial   Boolean       @default(false)
  remindAuto     Boolean       @default(false)
  // A charge made by "תרומות ונדרים" (board D-ModSynDonations): one per installment.
  pledgeId       String?
  pledge         Pledge?       @relation(fields: [pledgeId], references: [id], onDelete: SetNull)
  createdById    String? // User.id of the admin who sent it
  createdAt      DateTime      @default(now())

  allocations PaymentAllocation[]
  disputes    ChargeDispute[]

  @@unique([orgId, dedupeKey])
  @@index([orgId, householdId, periodMonth])
  @@index([orgId, memberId])
  @@index([pledgeId])
}

// Either side may mark a charge as disputed. While a dispute is open, reminders for that charge stop.
// The platform records the dispute and keeps the history; it does not decide who is right and does
// not punish either side.
model ChargeDispute {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargeId       String
  charge         Charge       @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  openedById     String // User.id
  openedBy       User         @relation(fields: [openedById], references: [id])
  openedBySide   String // member | org
  reason         String
  status         String       @default("open") // open | resolved | withdrawn
  resolutionNote String?
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  @@index([orgId, status])
  @@index([chargeId])
}

// Every collection reminder sent, so a hard limit (default: one per member per week) can be enforced
// in one place and nobody can be harassed through the platform. Disputed charges are never reminded.
model DebtReminder {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberId String
  member   Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channel  String // push | email | whatsapp_text | sms
  sentById String? // User.id, null for scheduled sends
  sentAt   DateTime     @default(now())

  @@index([orgId, memberId, sentAt])
}

// Money received. Provider-agnostic: card via a processor, cash, bank transfer, standing order.
model Payment {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fundId           String?
  fund             Fund?        @relation(fields: [fundId], references: [id])
  householdId      String?
  household        Household?   @relation(fields: [householdId], references: [id])
  memberId         String?
  member           Member?      @relation(fields: [memberId], references: [id])
  payerName        String? // as reported by the provider; may not match a Member
  payerPhone       String?
  payerEmail       String?
  amountMinor      Int
  currency         String       @default("ILS")
  method           String       @default("card") // card | cash | bank | standing_order | other
  provider         String? // e.g. "nedarim", "cardcom", "stripe"
  providerTxId     String? // external id; unique per org+provider so webhooks are idempotent
  // pending (a member's report waiting for the org) | succeeded | failed | refunded | rejected (report not confirmed)
  status           String       @default("succeeded")
  source           String       @default("manual") // webhook | manual | import | app (paid in the app) | report (member reported)
  cardLabel        String? // "Visa ••4242" as the provider reports it; never card data
  failureReason    String? // the provider's reason in plain words, for a failed payment
  note             String? // the member's note on a report, or the admin's on a manual record
  // A photo of the transfer confirmation, downscaled in the browser. Moves to file storage when we have it
  // (docs/waiting-for-services.he.md).
  proof            String?
  receiptNo        Int? // our running number per org for the in-app receipt; the official one is the Invoice
  reviewedById     String? // User.id of the admin who confirmed or rejected a report
  reviewedAt       DateTime?
  isRecurring      Boolean      @default(false)
  recurringRef     String? // groups installments of one standing order, when the provider tells us
  platformFeeMinor Int          @default(0) // our cut, computed from Organization.platformFeeBps
  rawPayload       Json? // original provider payload, kept for audit and re-processing
  receivedAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())

  allocations PaymentAllocation[]
  invoice     Invoice?

  @@unique([orgId, provider, providerTxId])
  @@unique([orgId, receiptNo])
  @@index([orgId, receivedAt])
  @@index([orgId, householdId])
}

// How a payment was applied against charges (oldest-first by default).
model PaymentAllocation {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  paymentId   String
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chargeId    String
  charge      Charge       @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  amountMinor Int

  @@unique([paymentId, chargeId])
  @@index([orgId, chargeId])
}

// A legal receipt or invoice issued through an external, licensed provider. We store the reference.
model Invoice {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  paymentId   String       @unique
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  provider    String // e.g. "icount", "green-invoice"
  externalId  String?
  number      String?
  documentUrl String?
  createdAt   DateTime     @default(now())

  @@index([orgId])
}

// Where an org's money lands: its own sub-account at a payment processor.
model PaymentAccount {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider          String
  externalAccountId String // never store card data or API secrets here; secrets live in a vault
  status            String       @default("pending") // pending | verified | disabled
  createdAt         DateTime     @default(now())

  @@unique([orgId, provider])
}

// Money going out (HOA: הוצאות).
model Expense {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fundId      String?
  fund        Fund?        @relation(fields: [fundId], references: [id])
  category    String
  vendor      String?
  details     String?
  amountMinor Int
  currency    String       @default("ILS")
  spentOn     DateTime     @db.Date
  createdAt   DateTime     @default(now())

  @@index([orgId, spentOn])
}

// ---------------------------------------------------------------------------
// Community features
// ---------------------------------------------------------------------------

model Event {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type        String       @default("general") // pack-defined: brit | bar_mitzvah | wedding | class | meeting ...
  title       String
  description String?
  startsAt    DateTime
  dateLabel   String? // free-text display date, e.g. a Hebrew date
  location    String?
  memberId    String? // the celebrating member, if applicable
  member      Member?      @relation(fields: [memberId], references: [id])
  // "פעילויות ואירועים" (board D-AdmActivities): a draft is seen only by the managers.
  status      String       @default("published") // draft | published | cancelled
  signup      Boolean      @default(false) // "הרשמה מראש": members sign up in the app
  seats       Int? // "מקומות"; null = no limit
  priceMinor  Int? // "בתשלום": a charge is made when a member signs up
  payload     Json         @default("{}") // the pack's own fields, e.g. { minyan: true }
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  registrations EventRegistration[]

  @@index([orgId, startsAt])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orgId     String
  userId    String
  memberId  String?
  status    String   @default("going") // going | cancelled
  chargeId  String? // the charge made for a paid activity
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([orgId, userId])
}

// One generic table instead of d3teman's five near-identical request tables
// (Kiddush, Haftarah, Aliyah, EventNotification, GeneralInquiry). The pack declares the kinds
// and the payload shape; admins triage them all in one inbox.
// "פניות" (boards D-Inquiry*, D-AdmInquiries, D-AdmInquiry): one table for every org type; a pack only adds
// kinds and their fields (requestKinds). The conversation is in RequestMessage.
model Request {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  number     Int? // "#1042", per org, from 1001
  userId     String? // who wrote it
  kind       String // core: details | charge | general | other; or pack-defined, e.g. "kiddush_sponsorship"
  payload    Json         @default("{}")
  // new: no answer yet | answered: the org answered last | replied: the member wrote after an answer | closed
  status     String       @default("new")
  assigneeId String? // User.id of the manager handling it; none = the owner's
  followsId  String? // "בהמשך לפנייה קודמת"
  postId     String? // "בהמשך להודעה": a message from the org
  adminNotes String?
  lastAt     DateTime     @default(now()) // last message, for sorting and the 14-day auto close
  closedAt   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  messages   RequestMessage[]

  @@unique([orgId, number])
  @@index([orgId, kind, status])
  @@index([userId])
}

model RequestMessage {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String // User.id
  side      String // member | org
  internal  Boolean  @default(false) // "הערה פנימית": managers only
  body      String
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

// A signed-in user asks to join a "listed" org; an admin approves or rejects. Never self-service.
// Application rules: only for orgs with visibility "listed"; rate-limited per user per day;
// an admin may block a user from asking again.
model JoinRequest {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String?
  source      String? // link (the org's join link or its code, incl. posters) | search (found in the app). Older rows: null
  status      String       @default("pending") // pending | approved | rejected | withdrawn | blocked
  decidedById String? // User.id of the admin
  decidedAt   DateTime?
  adminNotes  String?
  createdAt   DateTime     @default(now())

  @@index([orgId, status])
  @@index([userId])
}

// Outbound communication (generalizes d3teman's Newsletter).
model Campaign {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel     String       @default("email") // email | whatsapp_text | sms
  subject     String
  targetGroup String       @default("all")
  items       Json // [{ category, title, body, imageUrl }]
  status      String       @default("draft") // draft | sent
  sentCount   Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sentAt      DateTime?

  @@index([orgId, status])
}

// Who did what, especially around money. Append-only.
model AuditLog {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId   String? // User.id, null for system or webhook actions
  action    String // e.g. "payment.recorded", "charge.voided", "member.role_changed"
  entity    String
  entityId  String?
  meta      Json         @default("{}")
  createdAt DateTime     @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, entity, entityId])
}

// ---------------------------------------------------------------------------
// PACK TABLES - structured data that only one pack needs. Keep this section small.
// ---------------------------------------------------------------------------

// synagogue pack (from d3teman): memorial dates per member.
model Yahrzeit {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  deceasedName String
  relation     String // father | mother | brother | sister | husband | wife | son | daughter | other
  hebrewDay    Int
  hebrewMonth  String
  notes        String?
  // Board D-ModSynYahrzeit: "תזכורת למשפחה" and "הודעה לקהל". remindedFor is the Hebrew year whose reminder
  // was already sent, so it goes out once a year.
  remind       Boolean      @default(true)
  announce     Boolean      @default(false)
  remindedFor  Int?
  createdById  String?
  createdAt    DateTime     @default(now())

  @@index([orgId, hebrewMonth, hebrewDay])
}

// synagogue pack: "תרומות ונדרים" (board D-ModSynDonations). An aliyah, a pledge or a donation, recorded by the
// gabbai. Its money lives in the charges it made (one, or one per monthly installment); its state is theirs.
model Pledge {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind         String // aliyah | pledge | donation
  purpose      String // "שמחת תורה", "תיקון ספר תורה", "כללי"
  amountMinor  Int
  installments Int          @default(1)
  note         String?
  // "בעילום שם" (synagogue-tools 33): every list, report and staff screen shows "בעילום שם"; only the identity
  // keeper (the treasurer, or the owner when there is none) sees who it was.
  anonymous    Boolean      @default(false)
  cancelledAt  DateTime?
  // Where it came from when not typed by the gabbai: "yahrzeit|<yahrzeitId>|<year key>" for a dedication made from
  // a yahrzeit reminder (one per yahrzeit day).
  ref          String?
  createdById  String?
  createdAt    DateTime     @default(now())

  charges Charge[]

  @@unique([orgId, ref])
  @@index([orgId, createdAt])
}

// synagogue pack: "תפילות ולוח זמנים" (board D-ModSynSchedule). The regular week, typed once and repeated:
// day 0 is Sunday and 6 is Shabbat, time is "HH:MM" Israel time.
model Prayer {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  day       Int
  name      String // שחרית, מנחה וערבית, קבלת שבת...
  time      String
  place     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  changes PrayerChange[]

  @@index([orgId, day])
}

// A one-time change on one date ("שבוע זה"): a regular prayer moved or cancelled that day, or an extra prayer
// (prayerId null) added for that date only.
model PrayerChange {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  prayerId  String?
  prayer    Prayer?      @relation(fields: [prayerId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  cancelled Boolean      @default(false)
  name      String?
  time      String?
  place     String?
  createdAt DateTime     @default(now())

  @@unique([prayerId, date])
  @@index([orgId, date])
}

// hoa pack (from the HOA project): parking registry.
model ParkingSpot {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number      String
  householdId String?
  household   Household?   @relation(fields: [householdId], references: [id])
  notes       String?

  @@unique([orgId, number])
}

// celebration pack: a guest's answer to a celebration (decided with Tommy 14.10.2026). Guests answer with a
// name only, no account; the browser keeps guestKey so they can change their answer. When a signed-in person
// answers, userId links it and the celebration shows in their wallet. Event details live in Organization.settings.
model Rsvp {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  guestKey  String       @unique // random, kept in the guest's browser
  userId    String?
  name      String
  status    String // yes | maybe | no
  people    Int          @default(1) // how many are coming, the guest included
  kids      Int          @default(0) // of them, children
  // Money is tracked, not moved (phase 1): the guest pays the organizer directly and marks it here.
  paid      String       @default("none") // none | claimed | confirmed
  paidMinor Int? // what the guest says they paid, in agorot
  paidAt    DateTime?
  answer    String? // to the organizer's own question, if there is one
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([orgId, userId])
  @@index([orgId, status])
}

// The updates channel (core, every org type; boards D-Channel, D-ChannelReact). The organizers write,
// everyone else reacts with an icon only: there is no chat (decided with Tommy 14.10.2026).
model ChannelPost {
  id           String          @id @default(cuid())
  orgId        String
  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authorId     String? // the organizer's user id
  title        String
  body         String
  pinned       Boolean         @default(false) // an important change, also shown at the top of the invitation
  reactable    Boolean         @default(true) // "לאפשר תגובות"
  dislike      Boolean         @default(true) // "לאפשר 'לא אהבתי'"
  // Messages to members (boards D-AdmMessage, D-AdmMessages). A celebration update has none of these: everyone
  // who answered sees it. A message has recipients, and only they see it.
  status       String          @default("sent") // draft | sent
  audience     Json? // what the admin chose, to reopen a draft
  audienceText String? // "לכולם", "אישית לדנה", "לפי תווית: מתנדבים"
  channels     String[]        @default([]) // app | email | sms
  remindedAt   DateTime? // "שליחת תזכורת למי שלא קראו", once
  createdAt    DateTime        @default(now())
  reactions    PostReaction[]
  recipients   PostRecipient[]

  @@index([orgId, createdAt])
}

// Who a message went to, and when they read it (board D-AdmMessages). Only admins see this.
model PostRecipient {
  id       String      @id @default(cuid())
  postId   String
  post     ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId   String
  memberId String?
  readAt   DateTime?

  @@unique([postId, userId])
  @@index([userId])
}

model PostReaction {
  id        String      @id @default(cuid())
  postId    String
  post      ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorKey  String // "u:<userId>" for an account, "r:<rsvpId>" for a celebration guest without one
  kind      String // heart | bravo | like | dislike | funny | got
  createdAt DateTime    @default(now())

  @@unique([postId, actorKey])
}

// Labels (תוויות, ux-spec 14.9/14.10, boards D-Labels, D-AdmLabels): a sign of a contribution, not a rank.
// A member may hold any number of them. Given by hand, or automatically to whoever holds an active
// subscription to a plan. "admins" labels are never shown to the member.
model MembershipLabel {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String // up to 14 characters
  color      String // one of the six label colors
  visibility String       @default("all") // all | admins
  assignment String       @default("manual") // manual | auto_plan
  planId     String?
  plan       Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  holders MemberLabel[]

  @@unique([orgId, name])
  @@index([orgId])
}

// A label given by hand to a member.
model MemberLabel {
  id           String          @id @default(cuid())
  orgId        String
  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  labelId      String
  label        MembershipLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedById String? // the admin's user id
  since        DateTime        @default(now())

  @@unique([labelId, memberId])
  @@index([orgId, memberId])
}

// What the member's "הודעות" screen and the bells show (boards D-Notifications, D-NotificationsDone).
// "action" waits for something to be done (a charge to pay, a request to answer) and is closed when it is
// handled; "update" is closed when read. Delivery by push, SMS or email waits for the messages service
// (docs/waiting-for-services.he.md).
model Notification {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId       String? // null: from the wallet itself
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind        String // action | update
  topic       String // charge | payment | report | join_request | join_answer | label
  refId       String? // what it is about (a charge, a join request), to close it when handled
  text        String
  href        String?
  actionLabel String?
  createdAt   DateTime      @default(now())
  readAt      DateTime?
  doneAt      DateTime?

  @@index([userId, createdAt])
  @@index([topic, refId])
}

// One "ייבוא חברים מקובץ" run (boards D-AdmImport1-3), for the "ייבואים אחרונים" list and its report.
model ImportBatch {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fileName    String
  rows        Int // rows in the file
  imported    Int // people taken in (invited, or listed only)
  mode        String // invite | list
  channel     String? // whatsapp | sms | email, for mode invite
  remind      Boolean      @default(true) // one reminder after 3 days to whoever did not accept
  createdById String
  createdAt   DateTime     @default(now())

  invitations Invitation[]

  @@index([orgId, createdAt])
}

// "שמירה כטיוטה" on a new charge (board D-AdmCharge): what the admin filled in, not yet sent to anyone.
model ChargeDraft {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  data        Json // ChargeInput, see src/lib/billing/charge-plan.ts
  createdById String
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())

  @@index([orgId])
}
