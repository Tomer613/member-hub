# Postgres. DATABASE_URL = pooled app connection, DIRECT_URL = direct connection for migrations.
DATABASE_URL=
DIRECT_URL=
# Long random string for signing session cookies (openssl rand -base64 48)
SESSION_SECRET=
# Public base URL of the deployed site, used to build absolute links in emails
APP_URL=
# Email provider (carried over from d3teman: Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Payment provider keys are added per provider when each integration is built.
# Per-org provider secrets do NOT go in env: they belong in a secrets vault, referenced by PaymentAccount.
